// Shared by the legacy and ES-module GNOME Shell entry points.
const DESKTOP = 'org.arandulab.Tape.desktop';
const BUS_PATH = '/org/arandulab/Tape/Windows';
const XML = '<node><interface name="org.arandulab.Tape.Windows1">' +
    '<method name="Snapshot"><arg direction="out" type="s"/></method>' +
    '<method name="AssistiveStatus"><arg direction="out" type="s"/></method>' +
    '<method name="Activate"><arg direction="in" type="s"/><arg direction="out" type="b"/></method>' +
    '<method name="Clear"/><method name="Center"/><method name="AssistiveCommand"><arg direction="in" type="s"/><arg direction="out" type="b"/></method></interface></node>';
const RIVERS = ['memory', 'open', 'frequent'];
const RIVER_NAMES = {memory:'Memória', open:'Abertos', frequent:'Frequentes'};
const ACTIONS = {memory:'Memory', open:'Open', frequent:'Frequent'};
const TITLES = {memory:[218,277], open:[909,60], frequent:[977,177]};
const LAYOUT = __LAYOUT__;
const DYNAMIC_RIVERS = __DYNAMIC_RIVERS__;
const SLOTS = [[2],[2],[1,3],[0,2,4],[0,1,3,4],[0,1,2,3,4]];
const stopSource = id => { if (id) GLib.Source.remove(id); };
const limit = (value,lo,hi) => Math.max(lo,Math.min(hi,value));
function parseSetting(value, fallback) {
    try {return JSON.parse(value);} catch (_) {return fallback;}
}

class TapeSession {
    constructor(path, settings) {
        this.path=path; this.settings=settings; this.links=[]; this.buttons={};
        this.riverLabels={}; this.items={}; this.later=0; this.writeId=0; this.hoverId=0;
        this.trackId=0; this.drag=null; this.layer=null; this.tracked=[]; this.dragged=false; this.expanded=false;
        // Semente adaptativa: nenhum recolhimento automático dos rios.
        this.seedSleepId=0; this.seedAwake=true;
        this.helpSleepId=0; this.helpAwake=true;
        this.medallionSleepId=0; this.medallionsAwake=false;
        this.navRiver=null;this.navIndex=-1;this.navBindings=[];
        this.scanTimer=0;this.scanning=false;
        this.navigationOverlay=false;this.navigationMonitorIndex=null;
        this.navigationIdleTimer=0;this.navigationLastWindow=null;
        this.tracker=Shell.WindowTracker.get_default();
        this.apps=Shell.AppSystem.get_default();
        this.privacy=new Gio.Settings({schema_id:'org.gnome.desktop.privacy'});
        const recent=parseSetting(settings.get_string('recent'),'');
        const freq=parseSetting(settings.get_string('frequency'),{});
        this.recent=Array.isArray(recent)?recent:[];
        this.frequency=freq && typeof freq==='object' && !Array.isArray(freq)?freq:{};
        this.lastFocus='';
    }
    signal(obj,name,fun) {this.links.push([obj,obj.connect(name,fun)]);}
    start() {
        this.service=Gio.DBusExportedObject.wrapJSObject(XML,this);
        this.service.export(Gio.DBus.session,BUS_PATH);
        this.panel=new PanelMenu.Button(0,'Arandu Tape',false);
        this.panel.add_child(this.icon('semente',22));
        this.panel.menu.addAction('Abrir Arandu Tape',()=>this.launch());
        this.panel.menu.addAction('Expandir/recolher os três rios',()=>this.setExpanded(!this.expanded));
        for (const r of RIVERS) this.panel.menu.addAction(RIVER_NAMES[r],()=>this.launch(r));
        this.layerItem=this.panel.menu.addAction('Mostrar Semente sobre as janelas',()=>{
            this.settings.set_boolean('floating',this.layer!=='floating');
            this.applyLayer();
        });
        this.panel.menu.addAction('Centralizar a Semente',()=>this.Center());
        this.panel.menu.addAction('Monitor: acompanhar janela ativa',()=>this.setMonitorTarget('focused'));
        this.panel.menu.addAction('Monitor: acompanhar ponteiro/toque',()=>this.setMonitorTarget('pointer'));
        this.panel.menu.addAction('Monitor: principal',()=>this.setMonitorTarget('primary'));
        for(let monitor=0;monitor<3;monitor++){
            const i=monitor;
            this.panel.menu.addAction(`Monitor fixo ${i+1}`,()=>this.setMonitorTarget('fixed',i));
        }
        this.panel.menu.addAction('Guia dos Rios · atalhos',()=>this.toggleHelp());
        this.panel.menu.addAction('Acessibilidade · configurar na Semente',()=>this.toggleAccessibility());
        this.panel.menu.addAction('Varredura assistiva: iniciar/parar',()=>this.scanning?this.stopScan():this.startScan());
        this.panel.menu.addAction('Varredura: lenta · 5 segundos',()=>this.setScanInterval(5000));
        this.panel.menu.addAction('Varredura: normal · 3,5 segundos',()=>this.setScanInterval(3500));
        this.panel.menu.addAction('Varredura: rápida · 2 segundos',()=>this.setScanInterval(2000));
        this.panel.menu.addAction('Mostrar/ocultar botão de ajuda',()=>this.toggleHelpButton());
        this.panel.menu.addAction('Barra: sempre visível',()=>this.setBarMode('visible'));
        this.panel.menu.addAction('Barra: sempre oculta',()=>this.setBarMode('hidden'));
        this.panel.menu.addAction('Barra: automática',()=>this.setBarMode('auto'));
        this.panel.menu.addAction('Recuperar barra superior',()=>this.setBarMode('visible'));
        this.panel.menu.addAction('Alternar barra (Super+Alt+H)',()=>this.cycleBarMode());
        this.panel.menu.addAction('Rios: recolher após 10 segundos',()=>this.setNavigationIdle(10000));
        this.panel.menu.addAction('Rios: recolher após 30 segundos',()=>this.setNavigationIdle(30000));
        this.panel.menu.addAction('Rios: recolher após 60 segundos',()=>this.setNavigationIdle(60000));
        this.panel.menu.addAction('Rios: nunca recolher por tempo',()=>this.setNavigationIdle(0));
        Main.panel.addToStatusArea('arandu-tape-confluencia',this.panel);
        Main.wm.addKeybinding('arandu-tape-mapa',this.settings,Meta.KeyBindingFlags.NONE,
            Shell.ActionMode.NORMAL|Shell.ActionMode.OVERVIEW,()=>this.launch());
        this.keyBound=true;
        Main.wm.addKeybinding('arandu-restaurar-barra',this.settings,Meta.KeyBindingFlags.NONE,
            Shell.ActionMode.NORMAL|Shell.ActionMode.OVERVIEW,()=>this.setBarMode('visible'));
        this.rescueKeyBound=true;
        // Atalhos globais assistivos: ação sobre os medalhões na área de trabalho.
        // O roteador de intenções usado aqui poderá receber comandos de câmera/voz.
        const actions={
            'arandu-rio-memoria':()=>this.selectRiver('memory'),
            'arandu-rio-abertos':()=>this.selectRiver('open'),
            'arandu-rio-frequentes':()=>this.selectRiver('frequent'),
            'arandu-no-anterior':()=>this.moveSelection(-1),
            'arandu-no-proximo':()=>this.moveSelection(1),
            'arandu-no-ativar':()=>this.activateSelection(),
            'arandu-no-cancelar':()=>this.cancelSelection(),
            'arandu-varredura-acionar':()=>this.scanSwitch(),
            'arandu-alternar-barra':()=>this.cycleBarMode(),
        };
        for(const [name,callback] of Object.entries(actions)){
            Main.wm.addKeybinding(name,this.settings,Meta.KeyBindingFlags.NONE,
                Shell.ActionMode.NORMAL|Shell.ActionMode.OVERVIEW,callback);
            this.navBindings.push(name);
        }
        // Não toma posse do painel em uma sessão com Hide Top Bar ativa.
        this.barTimer=GLib.timeout_add(GLib.PRIORITY_DEFAULT,300,()=>{
            this.updateBar();return GLib.SOURCE_CONTINUE;
        });
        this.buildDesktop();
        this.signal(global.stage,'captured-event',(_stage,event)=>this.helpGlobalEvent(event));
        this.signal(global.stage,'captured-event',(_stage,event)=>this.navigationKeyEvent(event));
        this.signal(global.stage,'captured-event',(_stage,event)=>this.navigationOutsideEvent(event));
        // O clique numa janela já focada pode não emitir notify::focus-window.
        // O foco do teclado dá um segundo sinal independente dessa troca.
        this.signal(global.stage,'notify::key-focus',()=>this.onKeyFocusChanged());
        this.signal(global.display,'notify::focus-window',()=>{
            this.onFocusWindowChanged();
            this.record();this.schedule();
        });
        this.signal(global.display,'window-created',()=>this.schedule());
        this.signal(global.window_manager,'destroy',()=>this.schedule());
        this.signal(Main.layoutManager,'monitors-changed',()=>this.position());
        this.signal(Main.overview,'showing',()=>{if(this.layer==='floating')this.root.hide();});
        this.signal(Main.overview,'hidden',()=>this.schedule());
        this.signal(this.privacy,'changed::remember-recent-files',()=>{this.lastFocus='';this.schedule();});
        this.record(); this.refresh();
    }
    // Diagnóstico de estado somente leitura para testes e acionadores assistivos.
    // Nunca executa uma ação ao consultar a seleção.
    AssistiveStatus() {
        if(!this.allowed())return JSON.stringify({available:false,scanning:false});
        const river=this.navRiver;
        const index=this.navIndex;
        const node=river && index>=0 ? this.buttons[river]?.[index] : null;
        const entry=node?.entry||null;
        return JSON.stringify({
            available:true,
            expanded:Boolean(this.expanded),
            scanning:Boolean(this.scanning),
            river:river||null,
            index:entry?index:-1,
            selected:entry?{title:String(entry.title||entry.app||'Aplicativo'),
                app:String(entry.app||'')}:null,
            intervalMs:this.settings.get_int('scan-interval-ms'),
            navigationOverlay:Boolean(this.navigationOverlay),
            monitorIndex:this.navigationMonitorIndex,
            idleTimeoutMs:this.settings.get_int('navigation-idle-ms')
        });
    }
    // Interface de acessibilidade única, independente do dispositivo de entrada.
    // Apenas comandos de uma lista fechada. Não executa shell nem recebe nomes arbitrários.
    AssistiveCommand(command) {
        if(!this.allowed() || typeof command!=='string')return false;
        const cmd=command.trim().toLowerCase();
        switch(cmd){
            case 'river:memory':this.selectRiver('memory');return true;
            case 'river:open':this.selectRiver('open');return true;
            case 'river:frequent':this.selectRiver('frequent');return true;
            case 'node:next':this.moveSelection(1);return true;
            case 'node:previous':this.moveSelection(-1);return true;
            case 'node:activate':
                if(!this.navRiver || this.navIndex<0)return false;
                this.activateSelection();return true;
            case 'node:cancel':this.cancelSelection();return true;
            case 'scan:start':return this.startScan();
            case 'scan:stop':this.stopScan();return true;
            case 'scan:switch':return this.scanSwitch();
            case 'seed:expand':this.setExpanded(true);return true;
            case 'seed:collapse':this.setExpanded(false);return true;
            case 'seed:toggle':this.setExpanded(!this.expanded);return true;
            default:return false;
        }
    }
    // Velocidade personalizável sem terminal, persistente por perfil.
    // Se estiver varrendo, reinicia apenas o relógio mantendo o medalhão selecionado.
    setScanInterval(ms) {
        if(!this.allowed() || ![2000,3500,5000].includes(ms))return false;
        this.settings.set_int('scan-interval-ms',ms);
        this.updateAccessibilityLabels();
        const running=this.scanning;
        if(running)this.startScan();
        Main.notify('ARANDU TAPE',`Varredura: ${(ms/1000).toLocaleString('pt-BR')} segundos por medalhão.`);
        return true;
    }
    // Preferências de acessibilidade por usuário, sem captura de teclas globais.
    setMedallionScale(scale) {
        if(![0.85,1,1.2].includes(scale))return false;
        this.settings.set_double('medallion-scale',scale);
        this.refresh();
        return true;
    }
    setHighContrast(on) {
        this.settings.set_boolean('high-contrast',Boolean(on));
        this.highlightSelection();
    }
    setSwitchShortcut(choice) {
        const bindings={
            space:['<Super><Alt>space'],
            s:['<Super><Alt>s']
        };
        if(!bindings[choice])return false;
        this.settings.set_strv('arandu-varredura-acionar',bindings[choice]);
        Main.notify('ARANDU TAPE','Tecla do acionador alterada. Se houver conflito com outros atalhos, restaure a opção Espaço.');
        return true;
    }
    resetAccessibility() {
        this.stopScan();
        this.setScanInterval(3500);
        this.setMedallionScale(1);
        this.setHighContrast(false);
        this.setSwitchShortcut('space');
        this.setBarMode('visible');
        this.updateAccessibilityLabels();
    }
    toggleAccessibility() {
        if(!this.controlScroll)return;
        this.controlScroll.visible=!this.controlScroll.visible;
        if(this.controlScroll.visible){this.wakeSeed();this.updateAccessibilityLabels();this.position();}
    }
    updateAccessibilityLabels() {
        if(!this.accessibilityLabels)return;
        const scale=this.settings.get_double('medallion-scale');
        const contrast=this.settings.get_boolean('high-contrast');
        const interval=this.settings.get_int('scan-interval-ms');
        const shortcuts=this.settings.get_strv('arandu-varredura-acionar');
        const switchName=shortcuts.includes('<Super><Alt>s')?'Super+Alt+S':'Super+Alt+Espaço';
        this.accessibilityLabels.speed.set_label('Varredura: '+(interval/1000).toLocaleString('pt-BR')+' s');
        this.accessibilityLabels.size.set_label('Medalhões: '+Math.round(scale*100)+'%');
        this.accessibilityLabels.contrast.set_label('Alto contraste: '+(contrast?'ligado':'desligado'));
        this.accessibilityLabels.switch.set_label('Acionador: '+switchName);
        this.accessibilityLabels.bar.set_label('Barra: '+this.settings.get_string('panel-mode'));
    }
    // Varredura opcional: nunca abre um programa automaticamente.
    // Uma tecla ou acionador inicia a varredura e confirma o item destacado.
    startScan() {
        if(!this.allowed())return false;
        this.stopScan();
        if(!this.navRiver)this.selectRiver('open');
        else if(!this.expanded)this.setExpanded(true);
        this.enterNavigation();
        const ids=this.selectableIndices(this.navRiver);
        if(!ids.length)return false;
        if(!ids.includes(this.navIndex))this.navIndex=ids[0];
        this.highlightSelection();this.wakeSeed();
        this.scanning=true;
        this.cancelNavigationTimeout();
        const interval=limit(this.settings.get_int('scan-interval-ms'),2000,5000);
        this.scanTimer=GLib.timeout_add(GLib.PRIORITY_DEFAULT,interval,()=>{
            if(!this.scanning || !this.allowed() || !this.expanded){this.stopScan();return GLib.SOURCE_REMOVE;}
            this.moveSelection(1);
            return GLib.SOURCE_CONTINUE;
        });
        Main.notify('ARANDU TAPE','Varredura iniciada. Super + Alt + Espaço confirma o medalhão; Super + Alt + 0 cancela.');
        return true;
    }
    stopScan() {
        this.scanning=false;
        if(this.scanTimer){stopSource(this.scanTimer);this.scanTimer=0;}
    }
    scanSwitch() {
        if(!this.scanning)return this.startScan();
        this.stopScan();
        if(!this.navRiver || this.navIndex<0)return false;
        this.activateSelection();
        return true;
    }
    // Destino da Confluência em configurações de múltiplos monitores.
    setMonitorTarget(mode,index=0) {
        if(!['focused','pointer','primary','fixed'].includes(mode))return false;
        this.settings.set_string('monitor-target',mode);
        if(mode==='fixed')this.settings.set_int('fixed-monitor-index',limit(index,0,7));
        if(this.navigationOverlay)this.navigationMonitorIndex=this.pickMonitorIndex();
        this.position();
        return true;
    }
    pickMonitorIndex() {
        const layout=Main.layoutManager;
        const monitors=layout.monitors||[];
        const fallback=layout.primaryMonitor?.index??0;
        const valid=i=>Number.isInteger(i) && (monitors.length===0 ? i===fallback : monitors.some(m=>m.index===i));
        const mode=this.settings.get_string('monitor-target');
        let index=fallback;
        if(mode==='fixed')index=this.settings.get_int('fixed-monitor-index');
        else if(mode==='focused') {
            const win=global.display.focus_window;
            if(win && typeof win.get_monitor==='function')index=win.get_monitor();
        } else if(mode==='pointer') {
            const [x,y]=global.get_pointer();
            const mon=monitors.find(m=>x>=m.x && x<m.x+m.width && y>=m.y && y<m.y+m.height);
            if(mon)index=mon.index;
        }
        return valid(index)?index:fallback;
    }
    // Painéis de auxílio são sempre opcionais: não acompanhar os rios ao entrar.
    dismissNavigationPanels() {
        if(this.helpBox)this.helpBox.hide();
        if(this.helpHint)this.helpHint.hide();
        if(this.controlScroll)this.controlScroll.hide();
        if(this.controlBox && !this.controlScroll)this.controlBox.hide();
    }
    // O clique/toque externo devolve a janela ao trabalho sem consumir o evento.
    navigationOutsideEvent(event) {
        if(!this.navigationOverlay || this.scanning || !this.root)return Clutter.EVENT_PROPAGATE;
        const kind=event.type();
        // Ao voltar a digitar numa janela, o foco de janela pode permanecer igual.
        // Detectar o foco real do teclado (não intercepta o evento).
        if(kind===Clutter.EventType.KEY_PRESS) {
            const focused=global.stage.get_key_focus?.();
            const inArandu=focused && (focused===this.root || this.root.contains(focused));
            if(focused && !inArandu)this.finishNavigation();
            return Clutter.EVENT_PROPAGATE;
        }
        if(kind!==Clutter.EventType.BUTTON_PRESS &&
           kind!==Clutter.EventType.BUTTON_RELEASE && kind!==Clutter.EventType.TOUCH_BEGIN)
            return Clutter.EVENT_PROPAGATE;
        const actor=typeof event.get_source==='function'?event.get_source():null;
        // Somente controles interativos contam como interação com o ARANDU.
        // A superfície transparente da Confluência não deve manter a navegação ativa.
        const controls=[this.seed,this.helpButton,this.helpBox,this.controlScroll,
            ...Object.values(this.riverLabels||{})];
        for(const river of RIVERS)for(const node of this.buttons[river]||[])controls.push(node.button);
        const inside=controls.some(control=>control && actor &&
            (actor===control || control.contains?.(actor)));
        if(inside){
            this.resetNavigationTimeout();
            return Clutter.EVENT_PROPAGATE;
        }
        if(actor && this.panel && (actor===this.panel || this.panel.contains(actor)))
            return Clutter.EVENT_PROPAGATE;
        this.finishNavigation();
        return Clutter.EVENT_PROPAGATE;
    }
    onKeyFocusChanged() {
        if(!this.navigationOverlay || this.scanning || !this.root)return;
        const focused=global.stage.get_key_focus?.();
        if(!focused)return;
        if(focused===this.root || this.root.contains(focused))return;
        // Preserva menus do painel GNOME; o foco em aplicativos recolhe os rios.
        if(this.panel && (focused===this.panel || this.panel.contains(focused)))return;
        this.finishNavigation();
    }
    onFocusWindowChanged() {
        const focused=global.display.focus_window;
        if(this.navigationOverlay && focused && focused!==this.navigationLastWindow) {
            this.finishNavigation();
        }
    }
    cancelNavigationTimeout() {
        if(this.navigationIdleTimer)stopSource(this.navigationIdleTimer);
        this.navigationIdleTimer=0;
    }
    resetNavigationTimeout() {
        this.cancelNavigationTimeout();
        if(!this.navigationOverlay || this.scanning)return;
        const ms=this.settings.get_int('navigation-idle-ms');
        if(ms<=0)return;
        this.navigationIdleTimer=GLib.timeout_add(GLib.PRIORITY_DEFAULT,ms,()=>{
            this.navigationIdleTimer=0;
            if(this.navigationOverlay && !this.scanning)this.finishNavigation();
            return GLib.SOURCE_REMOVE;
        });
    }
    setNavigationIdle(ms) {
        if(![0,10000,30000,60000].includes(ms))return false;
        this.settings.set_int('navigation-idle-ms',ms);
        this.resetNavigationTimeout();
        Main.notify('ARANDU TAPE',ms?'Recolher rios após '+(ms/1000)+' s de inatividade.':'Recolhimento por inatividade desligado.');
        return true;
    }
    finishNavigation() {
        this.cancelNavigationTimeout();
        this.stopScan();
        this.dismissNavigationPanels();
        this.leaveNavigation();
        if(this.expanded)this.setExpanded(false);
        this.navRiver=null;
        this.navIndex=-1;
        this.highlightSelection();
    }
    // Modo transitório: a Semente e os Rios sobem juntos e depois retornam ao desktop.
    enterNavigation() {
        if(!this.allowed())return;
        this.dismissNavigationPanels();
        if(!this.navigationOverlay)this.navigationMonitorIndex=this.pickMonitorIndex();
        this.navigationOverlay=true;
        this.navigationLastWindow=global.display.focus_window;
        this.applyLayer();
        this.dismissNavigationPanels();
        this.resetNavigationTimeout();
    }
    leaveNavigation() {
        this.cancelNavigationTimeout();
        this.dismissNavigationPanels();
        if(!this.navigationOverlay)return;
        this.navigationOverlay=false;
        this.navigationMonitorIndex=null;
        this.navigationLastWindow=null;
        this.applyLayer();
    }
    // Intent Router: os dispositivos de entrada chamam estas ações sem tocar no layout.
    selectRiver(river) {
        if(!RIVERS.includes(river) || !this.allowed())return;
        if(!this.expanded)this.setExpanded(true);
        this.enterNavigation();
        this.refresh();
        this.wakeMedallions();
        this.wakeSeed();
        this.navRiver=river;
        this.navIndex=this.firstSelectable(river);
        this.highlightSelection();
        this.focusSelectedNode();
        this.resetNavigationTimeout();
    }
    firstSelectable(river) {
        return this.buttons[river].findIndex(n=>n.entry!==null && n.entry!==undefined);
    }
    selectableIndices(river) {
        return this.buttons[river].map((n,i)=>n.entry?i:-1).filter(i=>i>=0);
    }
    moveSelection(delta) {
        if(!this.allowed())return;
        if(!this.navRiver){this.selectRiver('open');return;}
        this.refresh();
        this.wakeMedallions();
        this.wakeSeed();
        const ids=this.selectableIndices(this.navRiver);
        if(!ids.length){this.navIndex=-1;this.highlightSelection();return;}
        const ix=ids.indexOf(this.navIndex);
        this.navIndex=ids[(ix+delta+ids.length)%ids.length];
        this.highlightSelection();
        this.focusSelectedNode();
        this.resetNavigationTimeout();
    }
    activateSelection() {
        if(!this.allowed() || !this.navRiver || this.navIndex<0)return;
        const node=this.buttons[this.navRiver][this.navIndex];
        if(!node || !node.entry)return;
        this.wakeMedallions();
        this.wakeSeed();
        this.openNode(this.navRiver,this.navIndex);
        this.finishNavigation();
        // Rios permanecem expandidos no desktop, sem bloquear o aplicativo.
        this.highlightSelection();
    }
    cancelSelection() {
        this.stopScan();
        this.finishNavigation();
        if(this.expanded)this.wakeMedallions();
    }
    // Enter simples e setas atuam SOMENTE quando o teclado está focado
    // num medalhão do ARANDU. Nunca interceptar digitação em outros aplicativos.
    focusSelectedNode() {
        if(!this.navRiver || this.navIndex<0)return;
        const node=this.buttons[this.navRiver]?.[this.navIndex];
        if(node?.entry && node.button?.visible && global.stage?.set_key_focus)
            global.stage.set_key_focus(node.button);
    }
    navigationKeyEvent(event) {
        if(!this.expanded || !this.navRiver || this.navIndex<0 ||
           event.type()!==Clutter.EventType.KEY_PRESS)return Clutter.EVENT_PROPAGATE;
        const node=this.buttons[this.navRiver]?.[this.navIndex];
        if(!node?.entry || global.stage.get_key_focus?.()!==node.button)
            return Clutter.EVENT_PROPAGATE;
        const symbol=event.get_key_symbol();
        if(symbol===Clutter.KEY_Return || symbol===Clutter.KEY_KP_Enter || symbol===Clutter.KEY_space){
            this.activateSelection();return Clutter.EVENT_STOP;
        }
        if(symbol===Clutter.KEY_Right){this.moveSelection(1);return Clutter.EVENT_STOP;}
        if(symbol===Clutter.KEY_Left){this.moveSelection(-1);return Clutter.EVENT_STOP;}
        if(symbol===Clutter.KEY_Escape){this.cancelSelection();return Clutter.EVENT_STOP;}
        return Clutter.EVENT_PROPAGATE;
    }
    highlightSelection() {
        if(!this.buttons)return;
        for(const river of RIVERS){
            const active=river===this.navRiver;
            const label=this.riverLabels[river];
            if(label){
                if(active)label.add_style_class_name('arandu-river-selected');
                else label.remove_style_class_name('arandu-river-selected');
            }
            for(const [index,node] of this.buttons[river].entries()){
                const chosen=active && index===this.navIndex && !!node.entry && this.expanded;
                if(this.settings.get_boolean('high-contrast'))node.button.add_style_class_name('arandu-node-high-contrast');
                else node.button.remove_style_class_name('arandu-node-high-contrast');
                if(chosen)node.button.add_style_class_name('arandu-node-selected');
                else node.button.remove_style_class_name('arandu-node-selected');
            }
        }
        if(this.area && this.transforms)
            this.repaintRivers(this.area.width,this.area.height);
    }
    toggleHelpButton() {
        const next=!this.settings.get_boolean('show-help-button');
        this.settings.set_boolean('show-help-button',next);
        this.applyMedallionVisibility();
        if(next && this.expanded)this.wakeMedallions();
        if(this.helpHint)this.helpHint.hide();
        if(!next && this.helpBox)this.helpBox.hide();
        Main.notify('ARANDU TAPE',next?'Guia dos Rios visível junto à Semente.':'Botão Guia dos Rios oculto; a ajuda continua no menu ARANDU.');
    }
    toggleHelp() {
        if(!this.helpBox)return;
        this.helpBox.visible=!this.helpBox.visible;
        if(this.helpBox.visible){this.wakeSeed();this.wakeMedallions();this.positionHelp();}
        else this.scheduleHelpSleep();
    }
    helpGlobalEvent(event) {
        if(!this.helpBox || !this.helpBox.visible)return Clutter.EVENT_PROPAGATE;
        if(event.type()===Clutter.EventType.KEY_PRESS && event.get_key_symbol()===Clutter.KEY_Escape) {
            this.helpBox.hide();this.scheduleHelpSleep();return Clutter.EVENT_STOP;
        }
        if(event.type()===Clutter.EventType.BUTTON_PRESS) {
            const actor=event.get_source();
            const inside=box=>box && (actor===box || box.contains(actor));
            if(!inside(this.helpBox) && !inside(this.helpButton)){this.helpBox.hide();this.scheduleHelpSleep();}
        }
        return Clutter.EVENT_PROPAGATE;
    }
    positionHelp() {
        if(!this.seedPoint || !this.area || !this.helpBox)return;
        const [sx,sy]=this.seedPoint,w=this.area.width,h=this.area.height;
        // Todos os elementos permanecem dentro da área útil, inclusive em telas pequenas.
        const margin=8;
        const buttonX=limit(sx+72,margin,Math.max(margin,w-44));
        const buttonY=limit(sy+54,margin,Math.max(margin,h-44));
        this.helpButton.set_position(Math.round(buttonX),Math.round(buttonY));
        this.helpHint.set_position(Math.round(limit(buttonX+38,margin,Math.max(margin,w-160))),
                                   Math.round(limit(buttonY+4,margin,Math.max(margin,h-27))));
        const panelW=Math.max(140,Math.min(365,w-2*margin));
        const panelH=Math.max(115,Math.min(535,h-2*margin));
        // O painel abre preferencialmente à esquerda ou acima da Semente quando necessário.
        const preferredX=buttonX+48+panelW<=w-margin ? buttonX+48 : buttonX-panelW-12;
        const panelX=limit(preferredX,margin,Math.max(margin,w-panelW-margin));
        const preferredY=buttonY-panelH+38;
        const panelY=limit(preferredY,margin,Math.max(margin,h-panelH-margin));
        this.helpBox.set_width(panelW);
        this.helpBox.set_height(panelH);
        // O conteúdo rola dentro de uma área com limites; título e fechamento ficam visíveis.
        if(this.helpScroll)this.helpScroll.set_height(Math.max(35,panelH-106));
        this.helpBox.set_position(Math.round(panelX),Math.round(panelY));
    }
    makeHelpPanel() {
        this.helpButton=new St.Button({label:'?',style_class:'arandu-help-medallion',can_focus:true,
            reactive:true,track_hover:true,accessible_name:'Guia dos Rios · consultar atalhos'});
        this.helpButton.connect('clicked',()=>this.toggleHelp());
        this.helpButton.connect('notify::hover',()=>{if(this.helpButton.hover){this.wakeSeed();this.wakeMedallions();}else this.scheduleHelpSleep();});
        this.root.add_child(this.helpButton);
        this.helpHint=new St.Label({text:'Atalhos dos Rios',style_class:'arandu-help-hint',visible:false});
        this.root.add_child(this.helpHint);
        this.helpButton.connect('notify::hover',()=>{this.helpHint.visible=this.helpButton.hover && !this.helpBox.visible && this.helpAwake && this.medallionsAwake;});
        this.helpBox=new St.BoxLayout({vertical:true,style_class:'arandu-help-panel',visible:false});
        const title=new St.Label({text:'◇ GUIA DOS RIOS',style_class:'arandu-help-title'});
        this.helpBox.add_child(title);
        const rows=[
            ['MAPA','Super + Shift + T','Abrir o ARANDU TAPE'],
            ['MEMÓRIA','Super + Alt + 1','Selecionar rio e primeiro medalhão'],
            ['ABERTOS','Super + Alt + 2','Selecionar rio e primeiro medalhão'],
            ['FREQUENTES','Super + Alt + 3','Selecionar rio e primeiro medalhão'],
            ['BUSCA','Ctrl + K','Pesquisar no mapa'],
            ['ANTERIOR','← / Super + Alt + ←','Medalhão anterior'] ,
            ['PRÓXIMO','→ / Super + Alt + →','Próximo medalhão'],
            ['ABRIR','Enter no foco / Super + Alt + Enter','Abrir ou focar o aplicativo escolhido'],
            ['SAIR','Super + Alt + 0','Limpar seleção'],
            ['AJUDA','F1','Ajuda no mapa aberto'],
            ['VARREDURA','Super + Alt + Espaço','Iniciar varredura / confirmar medalhão'],
            ['VOLTAR','Esc','Fechar ou voltar'],
            ['TOPBAR','Super + Alt + B','Recuperar barra superior'],
        ];
        this.helpScroll=new St.ScrollView({style_class:'arandu-help-scroll',overlay_scrollbars:true,
            hscrollbar_policy:St.PolicyType.NEVER,vscrollbar_policy:St.PolicyType.AUTOMATIC});
        const helpRows=new St.BoxLayout({vertical:true,style_class:'arandu-help-rows'});
        this.helpScroll.set_child(helpRows);
        this.helpBox.add_child(this.helpScroll);
        for(const [name,key,description] of rows){
            const line=new St.BoxLayout({vertical:false,style_class:'arandu-help-row'});
            const left=new St.BoxLayout({vertical:true,x_expand:true});
            left.add_child(new St.Label({text:name,style_class:'arandu-help-name'}));
            left.add_child(new St.Label({text:description,style_class:'arandu-help-description'}));
            line.add_child(left);
            line.add_child(new St.Label({text:key,style_class:'arandu-help-shortcut'}));
            helpRows.add_child(line);
        }
        helpRows.add_child(new St.Label({text:'SOBRE O ARANDU',style_class:'arandu-help-title'}));
        for(const info of ['Desenvolvimento: Rafhael Brum Werlang',
            'Aprendizagem significativa e acessibilidade',
            'DOI: ainda não registrado nesta compilação',
            'Licenciamento: revisão pendente']){
            const label=new St.Label({text:info,style_class:'arandu-help-description'});
            if (label.clutter_text) label.clutter_text.line_wrap=true;
            helpRows.add_child(label);
        }
        for(const [name,uri] of [
            ['GitHub · código e documentação','https://github.com/werlangunipampa-web/ARANDU-TAPE'],
            ['Releases · versões e atualizações','https://github.com/werlangunipampa-web/ARANDU-TAPE/releases'],
            ['Zenodo · consultar registros','https://zenodo.org/']
        ]){
            const link=new St.Button({label:name,style_class:'arandu-help-close',can_focus:true});
            link.connect('clicked',()=>{
                try{Gio.AppInfo.launch_default_for_uri(uri,null);}
                catch(_){Main.notify('ARANDU TAPE','Não foi possível abrir o endereço.');}
            });
            helpRows.add_child(link);
        }
        const foot=new St.Button({label:'Fechar  ×',style_class:'arandu-help-close',can_focus:true});
        foot.connect('clicked',()=>{this.helpBox.hide();this.scheduleHelpSleep();});this.helpBox.add_child(foot);
        this.root.add_child(this.helpBox);
        this.helpButton.visible=this.settings.get_boolean('show-help-button');
    }
    hideTopBarConflict() {
        try {
            const ext=Main.extensionManager.lookup('hidetopbar@mathieu.bidon.ca');
            return !!ext && ext.state===1; // GNOME ExtensionState.ENABLED
        } catch (_) {return false;}
    }
    // Alternar visibilidade sem mouse: sempre é possível restaurar com Super+Alt+B.
    cycleBarMode() {
        const mode=this.settings.get_string('panel-mode');
        this.setBarMode(mode==='visible'?'auto':mode==='auto'?'hidden':'visible');
    }
    setBarMode(mode) {
        if(!['visible','hidden','auto'].includes(mode))return;
        if(mode!=='visible' && this.hideTopBarConflict()) {
            Main.notify('ARANDU TAPE','Desativa primeiro a extensão Hide Top Bar para evitar conflito de controle.');
            return;
        }
        this.settings.set_string('panel-mode',mode);
        this.updateAccessibilityLabels();
        this.barLastNear=Date.now();
        this.updateBar();
        Main.notify('ARANDU TAPE',`Barra superior: ${mode==='visible'?'visível':mode==='hidden'?'oculta':'automática'}. Recuperar: Super + Alt + B`);
    }
    restorePanel() {
        // Nunca altera nem desativa arandu-topbar@local: só a visibilidade do painel GNOME.
        if(Main.panel && Main.panel.show)Main.panel.show();
    }
    updateBar() {
        if(!Main.panel || !Main.panel.hide || !Main.panel.show)return;
        const mode=this.settings.get_string('panel-mode');
        if(this.hideTopBarConflict() || !this.allowed() || Main.overview.visible) {
            this.restorePanel();return;
        }
        if(mode==='hidden'){Main.panel.hide();return;}
        if(mode!=='auto'){this.restorePanel();return;}
        // Nunca ocultar o painel enquanto um menu está aberto ou um controle
        // do próprio painel está focado pelo teclado assistivo.
        const menu=Main.panel.menuManager?.activeMenu;
        const focusedActor=global.stage?.get_key_focus?.();
        const focusOnPanel=focusedActor &&
            (focusedActor===Main.panel || Main.panel.contains?.(focusedActor));
        if(menu || focusOnPanel || this.panel?.menu?.isOpen){
            this.barLastNear=Date.now();
            this.restorePanel();
            return;
        }
        const [x,y]=global.get_pointer();
        const mon=Main.layoutManager.primaryMonitor;
        if(!mon){this.restorePanel();return;}
        // Área de aproximação inclui toda a altura da barra, e não só 14 pixels.
        // Uma pessoa com mobilidade reduzida precisa de tempo para encontrar o comando.
        const panelHeight=Math.max(44,Main.panel.height||0);
        const onPanel=x>=mon.x && x<=mon.x+mon.width &&
            y>=mon.y && y<=mon.y+panelHeight+14;
        if(onPanel)this.barLastNear=Date.now();
        const nearby=Date.now()-(this.barLastNear||0)<8000;
        if(nearby)this.restorePanel();else Main.panel.hide();
    }
    allowed() {return !Main.sessionMode.isLocked && !Main.sessionMode.isGreeter;}
    remembers() {return this.allowed() && this.privacy.get_boolean('remember-recent-files');}
    windows() {
        if (!this.allowed()) return [];
        return global.display.get_tab_list(Meta.TabList.NORMAL_ALL,null).filter(w=>{
            if (w.skip_taskbar || ![Meta.WindowType.NORMAL,Meta.WindowType.DIALOG,Meta.WindowType.MODAL_DIALOG].includes(w.get_window_type())) return false;
            const app=this.tracker.get_window_app(w);
            return app && app.get_id()!==DESKTOP && w.get_wm_class()!=='org.arandulab.Tape';
        });
    }
    describe(w) {
        const app=this.tracker.get_window_app(w);
        const ws=w.get_workspace();
        return {id:String(w.get_stable_sequence()),app:app.get_id(),
            title:w.get_title()||app.get_name(),where:ws?'Área de trabalho '+(ws.index()+1):'Todas as áreas'};
    }
    record() {
        const w=global.display.focus_window;
        if (!w || !this.remembers() || !this.windows().includes(w)) {this.lastFocus='';return;}
        const it=this.describe(w);
        if (it.id===this.lastFocus) return;
        this.lastFocus=it.id;
        const ts=Date.now()/1000;
        this.recent=[{app:it.app,title:it.title,ts},...this.recent.filter(r=>
            r.app!==it.app || r.title!==it.title)].slice(0,80);
        const prev=this.frequency[it.app];
        this.frequency[it.app]=[prev?prev[0]+1:1,ts];
        this.frequency=Object.fromEntries(Object.entries(this.frequency).sort((a,b)=>
            b[1][0]-a[1][0]||b[1][1]-a[1][1]).slice(0,180));
        if (!this.writeId) this.writeId=GLib.timeout_add(GLib.PRIORITY_DEFAULT,600,()=>{
            this.writeId=0;this.save();return GLib.SOURCE_REMOVE;
        });
    }
    save() {
        this.settings.set_string('recent',JSON.stringify(this.recent));
        this.settings.set_string('frequency',JSON.stringify(this.frequency));
    }
    Snapshot() {
        const keep=this.remembers();
        return JSON.stringify({windows:this.windows().map(w=>this.describe(w)),recent:keep?this.recent:[],
            frequency:keep?Object.entries(this.frequency).map(([id,[n,t]])=>[id,n,t]):[]});
    }
    Activate(id) {
        const w=this.windows().find(x=>String(x.get_stable_sequence())===id);
        if (!w) return false;
        Main.activateWindow(w,global.get_current_time());return true;
    }
    Clear() {
        if (!this.allowed()) return;
        this.recent=[];this.frequency={};this.save();this.schedule();
    }
    Center() {
        this.settings.set_double('anchor-x',0);this.settings.set_double('anchor-y',0);
        this.position();
    }
    launch(river) {
        if (!this.allowed()) return;
        const app=Gio.DesktopAppInfo.new(DESKTOP);
        if (!app) {Main.notify('Arandu Tape','Instala o aplicativo para abrir o mapa.');return;}
        const ctx=global.create_app_launch_context(0,-1);
        if (ACTIONS[river]) app.launch_action(ACTIONS[river],ctx);
        else app.launch([],ctx);
    }
    icon(file,size) {
        const path=GLib.build_filenamev([this.path,'assets',file+'.svg']);
        return new St.Icon({gicon:new Gio.FileIcon({file:Gio.File.new_for_path(path)}),icon_size:size});
    }
    buildDesktop() {
        this.root=new St.Widget({reactive:false,layout_manager:new Clutter.FixedLayout()});
        this.root.set_size(1200,500);this.root.set_pivot_point(0,0);
        this.fabric=new St.Widget({reactive:false});
        this.fabric.set_size(1200,500);this.root.add_child(this.fabric);
        for (const r of RIVERS) {
            this.buttons[r]=[];
            const title=new St.Button({label:RIVER_NAMES[r],style_class:'arandu-tag',can_focus:true});
            title.connect('clicked',()=>this.launch(r));this.watchHover(title);
            this.root.add_child(title);title.set_position(TITLES[r][0]-52,TITLES[r][1]-14);
            this.riverLabels[r]=title;
            for (let i=0;i<5;i++) {
                const b=new St.Button({can_focus:true,reactive:true});
                const stack=new St.Widget({layout_manager:new Clutter.FixedLayout()});stack.set_size(65,65);
                const med=this.icon(r,60);stack.add_child(med);
                b.set_child(stack);b.connect('clicked',()=>{this.wakeMedallions();this.openNode(r,i);this.finishNavigation();});
                b.connect('notify::hover',()=>{if(b.hover)this.wakeMedallions();});
                this.watchHover(b);this.root.add_child(b);
                this.buttons[r].push({button:b,stack,badge:null,key:null,entry:null});
            }
        }
        this.seed=new St.Button({can_focus:true,reactive:true,accessible_name:'Semente · Arandu Tape'});
        this.seed.set_child(this.icon('semente',149));this.seed.set_position(642-75,355-75);
        this.seed.connect('button-press-event',(_s,e)=>{
            if (e.get_button()===3) {
                this.toggleAccessibility();
                return Clutter.EVENT_STOP;
            }
            if (e.get_button()!==1) return Clutter.EVENT_PROPAGATE;
            this.dragged=false;this.beginDrag(e);return Clutter.EVENT_PROPAGATE;
        });
        this.seed.connect('clicked',()=>{
            if(!this.dragged)this.setExpanded(!this.expanded);
        });
        this.seed.track_hover=true;
        this.seed.connect('notify::hover',()=>{
            if(this.stopping)return;
            if(this.seed.hover){this.wakeSeed();if(this.expanded)this.wakeMedallions();}
            else this.scheduleSeedSleep();
        });
        this.root.add_child(this.seed);
        this.controlBox=new St.BoxLayout({vertical:true,style_class:'arandu-seed-controls',visible:false});
        this.accessibilityLabels={};
        const addTitle=text=>this.controlBox.add_child(new St.Label({
            text,style_class:'arandu-a11y-section'
        }));
        const addAction=(label,callback)=> {
            const button=new St.Button({label,style_class:'arandu-seed-control',
                can_focus:true,reactive:true});
            button.connect('clicked',()=>{callback();this.updateAccessibilityLabels();});
            this.controlBox.add_child(button);
            return button;
        };
        addTitle('ACESSIBILIDADE · ARANDU');
        addTitle('Varredura');
        this.accessibilityLabels.speed=addAction('Varredura: 3,5 s',()=>{
            const current=this.settings.get_int('scan-interval-ms');
            this.setScanInterval(current===5000?3500:current===3500?2000:5000);
        });
        addTitle('Tamanho dos medalhões');
        this.accessibilityLabels.size=addAction('Medalhões: 100%',()=>{
            const current=this.settings.get_double('medallion-scale');
            this.setMedallionScale(current<0.95?1:current<1.1?1.2:0.85);
        });
        this.accessibilityLabels.contrast=addAction('Alto contraste: desligado',()=>{
            this.setHighContrast(!this.settings.get_boolean('high-contrast'));
        });
        addTitle('Acionador de varredura');
        this.accessibilityLabels.switch=addAction('Acionador: Super+Alt+Espaço',()=>{
            const selected=this.settings.get_strv('arandu-varredura-acionar');
            this.setSwitchShortcut(selected.includes('<Super><Alt>s')?'space':'s');
        });
        addTitle('TOPBAR');
        this.accessibilityLabels.bar=addAction('Barra: visible',()=>this.cycleBarMode());
        addAction('Restaurar padrões seguros',()=>this.resetAccessibility());
        addAction('Fechar configurações',()=>this.controlScroll.hide());
        // Rolar em telas menores e manter ações alcançáveis por teclado.
        this.controlScroll=new St.ScrollView({style_class:'arandu-a11y-scroll',
            overlay_scrollbars:true,hscrollbar_policy:St.PolicyType.NEVER,
            vscrollbar_policy:St.PolicyType.AUTOMATIC});
        this.controlScroll.set_child(this.controlBox);
        this.controlBox.visible=true;
        this.controlScroll.visible=false;
        this.root.add_child(this.controlScroll);
        this.updateAccessibilityLabels();
        this.makeHelpPanel();
        this.applyLayer();this.setExpanded(false);this.position();
    }
    detachLayer() {
        const layout=Main.layoutManager;
        for (const actor of this.tracked) layout.untrackChrome(actor);
        this.tracked=[];
        if (this.layer==='floating')layout.removeChrome(this.root);
        else if(this.root && this.root.get_parent())this.root.get_parent().remove_child(this.root);
        this.layer=null;
    }
    applyLayer() {
        if (!this.root) return;
        const layout=Main.layoutManager;
        const floating=this.navigationOverlay || this.settings.get_boolean('floating') || !layout._backgroundGroup;
        const desired=floating?'floating':'desktop';
        if (this.layer!==desired) {
            this.detachLayer();
            if (floating) {
                layout.addChrome(this.root,{affectsStruts:false,affectsInputRegion:false,trackFullscreen:true});
                this.layer=desired;
                if(typeof layout.trackChrome==='function' && typeof layout.untrackChrome==='function') {
                    const controls=[this.seed,this.controlScroll,this.helpButton,this.helpBox,...Object.values(this.riverLabels)];
                    for(const r of RIVERS)for(const n of this.buttons[r])controls.push(n.button);
                    for(const actor of controls) {
                        layout.trackChrome(actor,{affectsStruts:false,affectsInputRegion:true,trackFullscreen:true});
                        this.tracked.push(actor);
                    }
                }
            } else {
                layout._backgroundGroup.add_child(this.root);
                this.layer=desired;
            }
        }
        this.layerItem.label.set_text(floating?'Mostrar Semente na área de trabalho':'Mostrar Semente sobre as janelas');
        this.position();this.refresh();
    }
    beginDrag(event) {
        this.endDrag();
        const [x,y]=event.get_coords();
        this.drag={x,y,ax:this.settings.get_double('anchor-x'),ay:this.settings.get_double('anchor-y')};
        this.trackId=global.stage.connect('captured-event',(_s,e)=>{
            if(e.type()===Clutter.EventType.MOTION && this.drag) {
                const [px,py]=e.get_coords();const dx=px-this.drag.x,dy=py-this.drag.y;
                if(Math.hypot(dx,dy)>6)this.dragged=true;
                if(this.dragged && this.area) {
                    this.drag.newX=limit(this.drag.ax+dx/this.area.width,-1,1);
                    this.drag.newY=limit(this.drag.ay+dy/this.area.height,-1,1);
                    this.position(this.drag.newX,this.drag.newY);
                }
            } else if(e.type()===Clutter.EventType.BUTTON_RELEASE && this.drag) {
                if(this.dragged && this.drag.newX!==undefined) {
                    this.settings.set_double('anchor-x',this.drag.newX);
                    this.settings.set_double('anchor-y',this.drag.newY);
                }
                this.endDrag();
            }
            return Clutter.EVENT_PROPAGATE;
        });
    }
    endDrag() {
        if(this.trackId)global.stage.disconnect(this.trackId);
        this.trackId=0;this.drag=null;
    }
    // Geometria única: SVG, medalhões e rótulos compartilham a mesma matriz.
    // Cada rio parte exatamente da Semente e alcança uma borda da área útil.
    makeTransform(r, endX, endY) {
        const index=RIVERS.indexOf(r), points=DYNAMIC_RIVERS.paths[index];
        const start=points[0], end=points[points.length-1];
        const dx=end[0]-start[0],dy=end[1]-start[1];
        const vx=endX-this.seedPoint[0],vy=endY-this.seedPoint[1];
        const denom=dx*dx+dy*dy;
        const a=(vx*dx+vy*dy)/denom;
        const b=(vy*dx-vx*dy)/denom;
        return [a,b,-b,a,this.seedPoint[0]-a*start[0]+b*start[1],
            this.seedPoint[1]-b*start[0]-a*start[1]];
    }
    transformPoint(m,p) {
        return [m[0]*p[0]+m[2]*p[1]+m[4],m[1]*p[0]+m[3]*p[1]+m[5]];
    }
    // Retorna um ponto da linha central do próprio SVG (sem interpolação divergente).
    riverPoint(r, t) {
        const points=DYNAMIC_RIVERS.paths[RIVERS.indexOf(r)];
        const u=limit(t,0,1)*(points.length-1);
        const i=Math.min(Math.floor(u),points.length-2),f=u-i;
        const p=[points[i][0]*(1-f)+points[i+1][0]*f,
            points[i][1]*(1-f)+points[i+1][1]*f];
        return this.transformPoint(this.transforms[r],p);
    }
    repaintRivers(w,h) {
        const cache=GLib.build_filenamev([GLib.get_user_cache_dir(),'arandu-tape-confluencia','rios']);
        GLib.mkdir_with_parents(cache,0o700);
        const filename=`rios-272-${w}-${h}-${Math.round(this.seedPoint[0])}-${Math.round(this.seedPoint[1])}-${this.expanded?this.navRiver||'none':'closed'}.svg`;
        const path=GLib.build_filenamev([cache,filename]);
        if(!GLib.file_test(path,GLib.FileTest.EXISTS)) {
            let svg=`<svg xmlns="http://www.w3.org/2000/svg" width="${w}" height="${h}" viewBox="0 0 ${w} ${h}">`;
            for(let i=0;i<RIVERS.length;i++) {
                const m=this.transforms[RIVERS[i]];
                svg+=`<g transform="matrix(${m.map(v=>v.toFixed(7)).join(' ')})">${DYNAMIC_RIVERS.groups[i]}</g>`;
            }
            // Destaque físico do rio ativo: linha central espessa e halo dourado.
            // Usa a MESMA geometria transformada dos nós e dos caminhos.
            if(this.expanded && this.navRiver && RIVERS.includes(this.navRiver)){
                const pathPoints=DYNAMIC_RIVERS.paths[RIVERS.indexOf(this.navRiver)];
                const points=pathPoints.map(p=>this.transformPoint(this.transforms[this.navRiver],p)
                    .map(v=>v.toFixed(2)).join(',')).join(' ');
                svg+=`<polyline points="${points}" fill="none" stroke="#e5be65" stroke-opacity="0.28" stroke-width="23" stroke-linecap="round" stroke-linejoin="round"/>`;
                svg+=`<polyline points="${points}" fill="none" stroke="#ffe2a0" stroke-opacity="0.82" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>`;
            }
            svg+='</svg>';
            GLib.file_set_contents(path,svg);
        }
        this.fabric.set_style(`background-image:url("${Gio.File.new_for_path(path).get_uri()}");background-size:100% 100%;`);
    }
    position(ax,ay) {
        if(!this.root || !Main.layoutManager.primaryMonitor)return;
        const layout=Main.layoutManager;
        const monitors=layout.monitors||[];
        const requested=this.navigationOverlay
            ? this.navigationMonitorIndex : this.pickMonitorIndex();
        const mon=monitors.find(m=>m.index===requested)||layout.primaryMonitor;
        if(!mon)return;
        // Se uma tela for desligada durante a navegação, migrar ao monitor restante.
        if(this.navigationOverlay && this.navigationMonitorIndex!==mon.index)
            this.navigationMonitorIndex=mon.index;
        const rect=layout.getWorkAreaForMonitor(mon.index);
        this.area=rect;
        const w=Math.max(1,rect.width),h=Math.max(1,rect.height);
        const px=ax===undefined?this.settings.get_double('anchor-x'):ax;
        const py=ay===undefined?this.settings.get_double('anchor-y'):ay;
        this.root.set_scale(1,1);
        this.root.set_size(w,h);
        this.root.set_position(rect.x,rect.y);
        this.fabric.set_size(w,h);
        const seedX=limit(w*.52+px*w*.20,95,w-95);
        const seedY=limit(h*.72+py*h*.18,100,h-100);
        this.seedPoint=[seedX,seedY];
        this.seed.set_position(Math.round(seedX-75),Math.round(seedY-75));
        if(this.helpButton)this.positionHelp();
        if(this.controlScroll){
            const panelW=Math.max(180,Math.min(310,w-16));
            const panelH=Math.max(140,Math.min(410,h-16));
            this.controlScroll.set_size(panelW,panelH);
            this.controlScroll.set_position(
                Math.round(limit(seedX+75,8,Math.max(8,w-panelW-8))),
                Math.round(limit(seedY-panelH/2,8,Math.max(8,h-panelH-8))));
        }
        this.transforms={
            memory:this.makeTransform('memory',-34,seedY),
            open:this.makeTransform('open',limit(seedX+w*.09,60,w-60),-34),
            frequent:this.makeTransform('frequent',w+34,limit(h*.34,60,h-60))
        };
        this.repaintRivers(w,h);
        this.layoutRivers();
    }
    layoutRivers() {
        if(!this.seedPoint || !this.area || !this.transforms)return;
        const w=this.area.width,h=this.area.height;
        const labelT={memory:.73,open:.76,frequent:.70};
        for(const r of RIVERS) {
            const actor=this.riverLabels[r],p=this.riverPoint(r,labelT[r]);
            const offset=r==='memory'?[0,-54]:r==='open'?[43,0]:[5,-60];
            actor.set_position(Math.round(limit(p[0]+offset[0]-52,3,w-110)),
                               Math.round(limit(p[1]+offset[1]-14,3,h-36)));
            for(const node of this.buttons[r]) {
                if(node.slot===undefined)continue;
                const [x,y]=this.riverPoint(r,(node.slot+1)/6);
                node.button.set_position(Math.round(limit(x-30,2,w-62)),
                                         Math.round(limit(y-30,2,h-62)));
            }
        }
    }
    // Os medalhões não fecham os rios ao perder o foco; a Semente é o único alternador.
    watchHover(actor) {
        actor.track_hover=true;
    }
    setSeedOpacity(alpha) {
        if(!this.seed)return;
        // Opacidade altera apenas a aparência; a área clicável permanece intacta.
        if(typeof this.seed.ease==='function')
            this.seed.ease({opacity:alpha,duration:450,mode:Clutter.AnimationMode.EASE_OUT_QUAD});
        else this.seed.opacity=alpha;
    }
    cancelHelpSleep() {stopSource(this.helpSleepId);this.helpSleepId=0;}
    scheduleHelpSleep() {
        this.cancelHelpSleep();
        if(!this.helpButton || !this.expanded || this.helpButton.hover || this.helpBox?.visible)return;
        // O ? repousa aos 6 segundos, um segundo antes da Semente central (7 s).
        this.helpSleepId=GLib.timeout_add(GLib.PRIORITY_DEFAULT,6000,()=>{
            this.helpSleepId=0;
            if(!this.helpButton.hover && !this.helpBox?.visible){
                this.helpAwake=false;
                this.applyMedallionVisibility();
            }
            return GLib.SOURCE_REMOVE;
        });
    }
    cancelSeedSleep() {
        stopSource(this.seedSleepId);this.seedSleepId=0;
    }
    wakeSeed() {
        this.cancelSeedSleep();
        this.seedAwake=true;
        this.helpAwake=true;
        if(this.expanded && this.buttons)this.applyMedallionVisibility();
        this.setSeedOpacity(255);
        this.scheduleSeedSleep();
    }
    scheduleSeedSleep() {
        this.cancelSeedSleep();
        this.scheduleHelpSleep();
        if(!this.seed || this.seed.hover)return;
        // Apenas a Semente central repousa após 7 s, com os rios abertos ou fechados.
        this.seedSleepId=GLib.timeout_add(GLib.PRIORITY_DEFAULT,7000,()=>{
            this.seedSleepId=0;
            if(!this.seed.hover && !this.drag) {
                this.seedAwake=false;
                this.setSeedOpacity(31); // 12%: quase invisível, ainda clicável
            }
            return GLib.SOURCE_REMOVE;
        });
    }
    // Os medalhões dos aplicativos permanecem visíveis enquanto os rios estão abertos.
    // Nada de temporizador para apagá-los; a Semente repousa independentemente.
    cancelMedallionSleep(){stopSource(this.medallionSleepId);this.medallionSleepId=0;}
    applyMedallionVisibility(){
        if(!this.buttons)return;
        const awake=this.expanded && this.medallionsAwake;
        for(const river of RIVERS)for(const node of this.buttons[river]){
            const b=node.button;
            if(!b)continue;
            const show=awake && !!node.entry;
            b.reactive=show;
            if(show){
                b.show();
                b.ease?.({opacity:255,duration:250,mode:Clutter.AnimationMode.EASE_OUT_QUAD});
                if(!b.ease)b.opacity=255;
            }else{
                if(b.ease)b.ease({opacity:0,duration:450,mode:Clutter.AnimationMode.EASE_OUT_QUAD});
                else b.opacity=0;
                // Não destruir o ator, seu foco nem sua seleção.
            }
        }
        if(this.helpButton){
            const helpVisible=awake && (this.helpAwake || !!this.helpBox?.visible) &&
                this.settings.get_boolean('show-help-button');
            this.helpButton.visible=awake && this.settings.get_boolean('show-help-button');
            this.helpButton.reactive=helpVisible;
            if(typeof this.helpButton.ease==='function')
                this.helpButton.ease({opacity:helpVisible?255:0,duration:350,mode:Clutter.AnimationMode.EASE_OUT_QUAD});
            else this.helpButton.opacity=helpVisible?255:0;
        }
        if(!awake && this.helpHint)this.helpHint.hide();
    }
    wakeMedallions(){
        // Mantém a interface navegável, inclusive por voz ou câmera.
        this.cancelMedallionSleep();
        this.medallionsAwake=true;
        this.applyMedallionVisibility();
    }
    setExpanded(on) {
        const wasExpanded=Boolean(this.expanded);
        this.expanded=Boolean(on);
        if(this.expanded && !wasExpanded)this.dismissNavigationPanels();
        if(!this.expanded){this.stopScan();this.leaveNavigation();}
        if(!this.root)return;
        this.wakeSeed();
        this.fabric.visible=this.expanded;
        for(const r of RIVERS)this.riverLabels[r].visible=this.expanded;
        if(this.expanded)this.wakeMedallions();
        else{this.cancelMedallionSleep();this.cancelHelpSleep();this.medallionsAwake=false;}
        this.applyMedallionVisibility();
        if(!this.expanded){
            if(this.helpBox)this.helpBox.hide();
            if(this.helpHint)this.helpHint.hide();
            if(this.controlScroll)this.controlScroll.hide();
        }
        this.scheduleSeedSleep();
        this.refresh();this.highlightSelection();
        this.applyMedallionVisibility();
    }
    schedule() {
        if(this.later)return;
        this.later=GLib.timeout_add(GLib.PRIORITY_DEFAULT,150,()=>{
            this.later=0;this.refresh();return GLib.SOURCE_REMOVE;
        });
    }
    refresh() {
        if(!this.root)return;
        const focused=global.display.focus_window;
        const ownApp=focused && this.tracker.get_window_app(focused);
        this.root.visible=this.layer!=='floating' ||
            (this.allowed() && !Main.overview.visible && (!ownApp || ownApp.get_id()!==DESKTOP));
        if(!this.expanded){
            for(const r of RIVERS)for(const node of this.buttons[r])node.button.hide();
            return;
        }
        const live=this.windows().map(w=>this.describe(w));
        const keep=this.remembers();
        const data={open:live,memory:keep?this.recent.slice(0,5):[],
            frequent:keep?Object.entries(this.frequency).sort((a,b)=>b[1][0]-a[1][0]||b[1][1]-a[1][1])
                .filter(([id])=>this.apps.lookup_app(id)).slice(0,5).map(([app])=>({app})):[]};
        for(const r of RIVERS) {
            const entries=data[r].slice(0,5),slots=SLOTS[entries.length];
            this.buttons[r].forEach((node,i)=>{
                if(i>=slots.length){node.button.hide();node.entry=null;node.slot=undefined;return;}
                const entry=entries[i]||null;node.entry=entry;
                node.slot=slots[i];
                const [x,y]=this.riverPoint(r,(node.slot+1)/6);
                const w=this.area?this.area.width:1200,h=this.area?this.area.height:500;
                const scale=this.settings.get_double('medallion-scale');
                node.button.set_scale(scale,scale);
                node.button.set_position(Math.round(limit(x-30*scale,2,w-62*scale)),
                    Math.round(limit(y-30*scale,2,h-62*scale)));
                const app=entry?this.apps.lookup_app(entry.app):null;
                if(node.key!==(entry?entry.app:'')){
                    if(node.badge){node.badge.destroy();node.badge=null;}
                    if(app){
                        node.badge=app.create_icon_texture(20);node.stack.add_child(node.badge);
                        node.badge.set_position(43,43);
                    }
                    node.key=entry?entry.app:'';
                }
                node.button.accessible_name=entry?(entry.title||(app?app.get_name():entry.app)):RIVER_NAMES[r];
                node.button.show();
            });
        }
        if(this.navRiver){
            const ids=this.selectableIndices(this.navRiver);
            if(!ids.includes(this.navIndex))this.navIndex=ids.length?ids[0]:-1;
        }
        this.highlightSelection();
        this.applyMedallionVisibility();
    }
    openNode(r,index) {
        const e=this.buttons[r][index].entry;
        if(!e){this.launch(r);return;}
        if(e.id && this.Activate(e.id))return;
        const w=this.windows().find(x=>{
            const d=this.describe(x);return d.app===e.app && (!e.title||d.title===e.title);
        });
        if(w){Main.activateWindow(w,global.get_current_time());return;}
        const app=this.apps.lookup_app(e.app);
        if(app)app.activate();else this.launch(r);
    }
    stop() {
        this.stopping=true;
        this.stopScan();
        this.cancelNavigationTimeout();
        this.endDrag();
        for(const [obj,id] of this.links)obj.disconnect(id);
        this.links=[];
        stopSource(this.later);stopSource(this.hoverId);stopSource(this.writeId);this.cancelSeedSleep();this.cancelHelpSleep();this.cancelMedallionSleep();
        if(this.writeId)this.save();
        this.restorePanel();
        stopSource(this.barTimer);this.barTimer=0;
        for(const name of this.navBindings)Main.wm.removeKeybinding(name);
        this.navBindings=[];
        if(this.rescueKeyBound)Main.wm.removeKeybinding('arandu-restaurar-barra');
        if(this.keyBound)Main.wm.removeKeybinding('arandu-tape-mapa');
        if(this.service)this.service.unexport();
        this.detachLayer();
        if(this.root)this.root.destroy();
        if(this.panel)this.panel.destroy();
        this.root=null;this.panel=null;this.service=null;
    }
}
