# ARANDU Desktop — sessão Wayland REAL opcional, NÃO laboratório aninhado.
# Sway gerencia janelas, ARANDU GTK4 é o painel; não é compositor ARANDU próprio.
set $mod Mod4
font pango:Sans 10
default_border pixel 2
default_floating_border pixel 2
gaps inner 7
gaps outer 5
workspace_layout tabbed
output * bg #14221d solid_color
client.focused #bba66e #20372f #f4f0df #91b59f #bba66e
client.unfocused #263e34 #192620 #b8c6b7 #263e34 #263e34

# Saída de emergência ao gerenciador de login.
bindsym Ctrl+Alt+Shift+q exit
bindsym $mod+Shift+Escape exit
# Voltar à Semente sem instanciar uma segunda cópia.
bindsym Ctrl+Alt+a [title="^ARANDU Desktop"] focus
bindsym $mod+Tab focus next
bindsym $mod+Shift+Tab focus prev
# Print copia PNG para a área de transferência (Ctrl+V).
bindsym Print exec __ARANDU_CAPTURE__
# Shift+Print salva PNG explicitamente em Imagens.
bindsym Shift+Print exec __ARANDU_CAPTURE_SAVE__
bindsym $mod+Return exec foot
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
# Não instalar swaylock/swayidle automaticamente: integração futura.
exec __ARANDU_LAUNCHER__
