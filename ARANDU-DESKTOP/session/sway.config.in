# ARANDU Desktop 0.4 — LABORATÓRIO ANINHADO, NÃO UMA SESSÃO DE LOGIN.
# Este arquivo não deve ser colocado em ~/.config/sway e não substitui GNOME.
set $mod Mod4
font pango:Sans 10
# Bordas e barras de título do Sway ocultas por padrão (visual ARANDU).
# Menus próprios dos aplicativos ainda podem ter cabeçalhos internos.
default_border none
default_floating_border none
gaps inner 8
gaps outer 6
# Janelas aninhadas usam abas: o ARANDU não fica espremido ao abrir Foot.
# Layout sem barra de abas. Opy (Alt+Tab) faz a navegação entre janelas.
# Super+T restaura temporariamente o layout com abas, se necessário.
workspace_layout default
bindsym $mod+t layout tabbed
bindsym $mod+e layout toggle split
client.focused #bba66e #20372f #f4f0df #91b59f #bba66e
client.unfocused #263e34 #192620 #b8c6b7 #263e34 #263e34
output * bg #14221d solid_color
# Saída de emergência — atua SOMENTE sobre este Sway aninhado.
bindsym Ctrl+Alt+Shift+q exit
bindsym $mod+Shift+Escape exit
# Navegação normal de janelas no compositor experimental.
# Opy: visão ARANDU das janelas em Alt+Tab, apenas na sessão Sway.
bindsym Mod1+Tab exec __ARANDU_OPY__
# Janela Opy flutua sobre as aplicações; não é um painel religioso ou layer-shell.
for_window [app_id="org.arandulab.OpySwitcher"] floating enable, resize set width 660 px height 460 px, move position center
bindsym $mod+Tab focus next
bindsym $mod+Shift+Tab focus prev
# Estabilidade primeiro: a interface ARANDU inicia VISÍVEL como aba normal.
# O scratchpad automático experimental 0.6.1 foi desativado por regressão.
# Ctrl+Alt+A retorna ao ARANDU; Super+Shift+Espaço habilita flutuação manual.
bindsym Ctrl+Alt+a [title="^ARANDU Desktop"] focus
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
# Ações explícitas para trabalhar sem botão X nem barra de título.
# 'kill' solicita fechamento da janela focada; saída de sessão tem outro atalho.
bindsym $mod+q kill
# Recolher janela ao scratchpad; Super+Shift+H a recupera.
bindsym $mod+h move scratchpad
bindsym $mod+Shift+h scratchpad show
# Terminal apenas nesta sessão aninhada; Foot instalado junto do Sway no Mint.
# Print copia PNG para a área de transferência (Ctrl+V).
bindsym Print exec __ARANDU_CAPTURE__
# Shift+Print salva PNG explicitamente em Imagens.
bindsym Shift+Print exec __ARANDU_CAPTURE_SAVE__
bindsym $mod+Return exec __ARANDU_TERMINAL__
# Exibe o programa de controle ARANDU; substituído por caminho absoluto temporário.
exec __ARANDU_LAUNCHER__
